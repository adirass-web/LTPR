---
import Foundation from '~/layouts/Foundation.astro';
import BookCover from '~/components/BookCover.astro';
import NarrativeFigure from '~/components/lab/NarrativeFigure.astro';
import { narrativeEvidence as evidence } from '~/data/narrativeReview';
import { homeV3 } from '~/content/en-v3';
import { sources } from '~/content/sources';
import { internationalForums } from '~/data/internationalForums';
import '~/assets/styles/narrative-review.css';
const portraitRoot = `${import.meta.env.BASE_URL}images/portraits/lior-tabansky-portrait-2x3`;
const portraitSet = (format: string) =>
  [480, 720, 1024].map((width) => `${portraitRoot}-${width}.${format} ${width}w`).join(', ');
---

<Foundation
  lang="en"
  dir="ltr"
  title="Editorial profile · Dr. Lior Tabansky"
  description="Integrated editorial profile — local design review."
  canonicalPath="/lab/single/narrative/"
  noindex
>
  <div class="nl-surface">
    <a class="nl-skip" href="#content">Skip to content</a>
    <header class="nl-header"><a href="#content">Dr. Lior Tabansky</a></header>
    <main id="content" class="nl-page" tabindex="-1">
      <section class="nl-opening" aria-labelledby="profile-title">
        <p class="nl-category">{homeV3.hero.category}</p>
        <div class="nl-identity">
          <h1 id="profile-title">{homeV3.hero.title}</h1>
          <figure class="nl-portrait">
            <picture>
              <source type="image/avif" srcset={portraitSet('avif')} sizes="(min-width: 800px) 216px, 160px" />
              <source type="image/webp" srcset={portraitSet('webp')} sizes="(min-width: 800px) 216px, 160px" />
              <img
                src={`${portraitRoot}-480.jpg`}
                srcset={portraitSet('jpg')}
                sizes="(min-width: 800px) 216px, 160px"
                width="1024"
                height="1536"
                alt="Dr. Lior Tabansky"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          </figure>
        </div>
        <p class="nl-intro">
          I work with governments and institutions to turn difficult technology and security problems into capabilities
          that work.
        </p>
      </section>

      <section class="nl-work" aria-labelledby="work-title">
        <h2 id="work-title">Selected work</h2>
        <div class="nl-records">
          <article>
            <a class="nl-eyebrow" href={sources.progressFieldRecord.url} target="_blank" rel="noopener noreferrer"
              >World Bank / PROGRESS ↗</a
            >
            <h3>Four critical sectors across 11 countries</h3>
            <p>
              Work across energy, healthcare, digital infrastructure and financial services translated sector-wide
              analysis into tailored recommendations.
            </p>
          </article>
          <article>
            <a class="nl-eyebrow" href={sources.strategicAdvisoryRecord.url} target="_blank" rel="noopener noreferrer"
              >Strategic advisory ↗</a
            >
            <h3>National cybersecurity strategy</h3>
            <p>
              Research and analysis developed into a strategic vision, guiding principles and tailored policy
              recommendations.
            </p>
          </article>
        </div>
        <p class="nl-note">{homeV3.publicWork.disclosure}</p>
      </section>

      <section class="nl-story" aria-labelledby="systems-title">
        <div class="nl-passage">
          <div class="nl-prose">
            <h2 id="systems-title">Technology is only part of the system.</h2>
            <p>
              Israel’s cyber advantage grew through connections between government, industry and universities. My work
              examines what can be transferred from that experience—and what cannot.
            </p>
            <a class="nl-book" href={homeV3.israelExperience.book.url} target="_blank" rel="noopener noreferrer">
              <BookCover alt={homeV3.israelExperience.book.alt} />
              <span
                ><span>{homeV3.israelExperience.book.title}</span><small>{homeV3.israelExperience.book.detail} ↗</small
                ></span
              >
            </a>
            <a class="nl-affiliation" href={homeV3.hero.role.url} target="_blank" rel="noopener noreferrer"
              >{homeV3.hero.role.title}<br />{homeV3.hero.role.institution} ↗</a
            >
          </div>
          <NarrativeFigure item={evidence.ecosystems} />
        </div>
        <div class="nl-passage">
          <div class="nl-prose nl-observation">
            <p>Innovation depends on the relationships between institutions, not just the technologies inside them.</p>
            <p class="nl-note">
              A public conversation on digital life, alongside the programme’s network-science artwork.
            </p>
          </div>
          <NarrativeFigure item={evidence.codice} />
        </div>
      </section>

      <section class="nl-story" aria-labelledby="decisions-title">
        <div class="nl-passage">
          <div class="nl-prose">
            <h2 id="decisions-title">Start with the decision.</h2>
            <p>{homeV3.work.areas[1].description}</p>
          </div>
          <NarrativeFigure item={evidence.decisions} />
        </div>
      </section>

      <section class="nl-story" aria-labelledby="infrastructure-title">
        <div class="nl-passage">
          <div class="nl-prose">
            <h2 id="infrastructure-title">The systems behind everyday life.</h2>
            <p>{homeV3.work.areas[2].description}</p>
          </div>
          <NarrativeFigure item={evidence.infrastructure} />
        </div>
        <div class="nl-passage">
          <div class="nl-prose nl-observation">
            <p>From undersea cables to device supply chains, digital dependence has physical consequences.</p>
          </div>
          <NarrativeFigure item={evidence.supplyChains} />
        </div>
      </section>

      <section class="nl-story" aria-labelledby="responsibility-title">
        <div class="nl-passage">
          <div class="nl-prose">
            <h2 id="responsibility-title">Capability brings responsibility.</h2>
            <p>
              Platforms, institutions and states make different decisions. Understanding where responsibility sits is
              part of understanding the system.
            </p>
          </div>
          <NarrativeFigure item={evidence.platforms} />
        </div>
        <div class="nl-passage">
          <div class="nl-prose nl-observation">
            <p>
              Surveillance makes these relationships visible: between an industry, the institutions that use it, and the
              people affected.
            </p>
          </div>
          <NarrativeFigure item={evidence.institutions} />
        </div>
        <div class="nl-passage">
          <div class="nl-prose nl-observation">
            <p>
              Technology is also part of statecraft. Technical possibility and institutional judgment are not the same
              thing.
            </p>
          </div>
          <NarrativeFigure item={evidence.statecraft} />
        </div>
      </section>

      <section class="nl-closing" aria-label="Approach and international record">
        <p class="nl-principle">{homeV3.method.paragraphs[1]}</p>
        <h2 class="nl-eyebrow">Selected international forums</h2>
        <ul class="nl-forums">
          {
            internationalForums.map((forum) => (
              <li>
                <a href={forum.url} target="_blank" rel="noopener noreferrer">
                  <>
                    <span>{forum.institution}</span>
                    <span aria-hidden="true">↗</span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <a class="nl-contact-rail" href="mailto:liortabansky@gmail.com">Contact ↗</a>
    <footer class="nl-footer">
      <span>Dr. Lior Tabansky</span><a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com ↗</a>
    </footer>
  </div>
</Foundation>
