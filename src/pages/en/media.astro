---
import ForestMedia from '~/components/ForestMedia.astro';
import Forest from '~/layouts/Forest.astro';
import { siteContent } from '~/content/site';
const metadata = siteContent.en.pages.media;
---

<Forest
  lang="en"
  dir="ltr"
  title={metadata.title}
  description={metadata.description}
  canonicalPath="/en/media/"
  pageClass="static-media"
  socialImage={{
    path: '/images/media/codice-2020-1024w.jpg',
    alt: 'Dr. Lior Tabansky on RAI’s Codice: la vita è digitale',
  }}
>
  <ForestMedia />
</Forest>
