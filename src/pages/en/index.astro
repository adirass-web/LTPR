---
import CinematicProfile from '~/components/CinematicProfile.astro';
import EditorialComposition from '~/components/EditorialComposition.astro';
import Foundation from '~/layouts/Foundation.astro';
import '~/assets/styles/ambient-profile.css';
const base = import.meta.env.BASE_URL;
---

<Foundation
  lang="en"
  dir="ltr"
  title="Dr. Lior Tabansky — Strategic technology adviser"
  description="Lior Tabansky advises companies and public institutions on cybersecurity, AI and critical infrastructure, with work across advanced and developing economies."
  canonicalPath="/en/"
>
  <div class="ambient-profile">
    <EditorialComposition>
      <CinematicProfile
        compact
        recordPath={`${base}en/media/`}
        bookSrc={`${base}images/publications/cybersecurity-in-israel.jpg`}
      />
    </EditorialComposition>
  </div>
</Foundation>
