---
import ForestProfile from '~/components/ForestProfile.astro';
import Forest from '~/layouts/Forest.astro';
import { siteContent } from '~/content/site';
const metadata = siteContent.en.pages.home;
---

<Forest
  lang="en"
  dir="ltr"
  title={metadata.title}
  description={metadata.description}
  canonicalPath="/en/"
  pageClass="full-profile"
>
  <ForestProfile />
</Forest>
