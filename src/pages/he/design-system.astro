---
import Portrait from '~/components/Portrait.astro';
import SiteShell from '~/components/SiteShell.astro';
import MediaPressCard from '~/components/media/MediaPressCard.astro';
import MediaVideoCard from '~/components/media/MediaVideoCard.astro';
import MoreCoverageItem from '~/components/media/MoreCoverageItem.astro';
import ResponsiveMediaImage from '~/components/media/ResponsiveMediaImage.astro';
import { archive, lead, press, pressKit, videos } from '~/data/media';
import '~/assets/styles/profile.css';
import '~/assets/styles/media.css';
import '~/assets/styles/rtl-specimen.css';

const specimenAreas = [
  {
    title: 'כותרת קצרה',
    text: 'טקסט עברי לדוגמה לבדיקת אורך שורה, מרווחים וקצב טיפוגרפי במבנה המאושר.',
  },
  {
    title: 'כותרת ארוכה יותר לבדיקת שבירת שורה',
    text: 'הטקסט כאן אינו תוכן לפרסום. הוא נועד לבדוק כיצד המבנה מתנהג כאשר הכותרת והפסקה ארוכות יותר.',
  },
  {
    title: 'AI, Cyber ו־Digital Trust',
    text: 'שילוב מונחים באנגלית בתוך משפט בעברית בודק בידוד דו־כיווני, סימני פיסוק ושמות מותג.',
  },
  {
    title: 'מספרים, שמות וקישורים',
    text: 'בדיקת 2026, World Bank, Singapore וכתובת liortabansky@gmail.com בתוך סביבת RTL.',
  },
];

const specimenRecord = [
  'פריט קצר לבדיקת היררכיה ורוחב טור.',
  'פריט ארוך יותר עם 2026 ו־World Bank לבדיקת כיווניות.',
  'שם באנגלית: Lior Tabansky לצד טקסט עברי.',
  'פריט רביעי לבדיקת ריווח בשתי עמודות.',
];

const publicPath = (path: string) => `${import.meta.env.BASE_URL}${path}`;
---

<SiteShell locale="he" page="home" home noindex canonicalPath="/he/design-system/">
  <div class="rtl-specimen">
    <aside class="rtl-specimen__notice" role="note">
      <strong>בדיקת פריסה בלבד.</strong>
      <bdi>Unlinked · noindex · not approved Hebrew editorial copy</bdi>
    </aside>

    <div class="home">
      <section id="profile" class="home-hero" aria-labelledby="rtl-home-title">
        <div class="home-hero__inner">
          <div class="home-hero__copy">
            <h1 id="rtl-home-title">כותרת ראשית בעברית לבדיקת הפריסה</h1>
            <p class="home-hero__standfirst">
              טקסט לדוגמה לבדיקת אורך שורה, קצב טיפוגרפי ושילוב מונחים באנגלית כגון
              <bdi>AI, Cyber, World Bank</bdi> בתוך מערכת RTL אמיתית.
            </p>
          </div>
          <Portrait variant="2x3" alt="ד״ר ליאור טבנסקי" priority />
        </div>
      </section>

      <section class="profile-section profile-section--areas" aria-labelledby="rtl-work-title">
        <div class="profile-section__header">
          <h2 id="rtl-work-title">מבנה לדוגמה</h2>
        </div>
        <ul class="profile-area-list">
          {
            specimenAreas.map((area) => (
              <li>
                <h3>{area.title}</h3>
                <div class="profile-area-list__copy">
                  <p>{area.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="profile-evidence" aria-labelledby="rtl-record-title">
        <div class="profile-evidence__record">
          <h2 id="rtl-record-title">רשומה לדוגמה</h2>
          <ul class="profile-record-list">
            {specimenRecord.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="profile-evidence__method" aria-labelledby="rtl-method-title">
          <h2 id="rtl-method-title">גישה לדוגמה</h2>
          <div class="profile-prose">
            <p>
              פסקה זו בודקת את טור הקריאה, סימני הפיסוק ואת המעבר בין עברית לבין
              <bdi>first principles, AI &amp; cyber</bdi> בלי לשנות את סדר ה־DOM.
            </p>
          </div>
        </div>
      </section>

      <section class="profile-close" aria-labelledby="rtl-public-title">
        <div class="profile-close__inner">
          <h2 id="rtl-public-title">תיעוד חזותי</h2>
          <div class="profile-close__body">
            <div class="profile-close__copy">
              <p>בדיקת יישור בין טקסט, תמונה וקישור במבנה דו־כיווני.</p>
              <a class="text-link" href="#rtl-media-title">מעבר לדוגמת מדיה</a>
            </div>
            <a class="profile-close__visual" href="#rtl-media-title" aria-label="מעבר לדוגמת מדיה">
              <ResponsiveMediaImage image={lead.image} sizes="(min-width: 64rem) 42vw, 100vw" />
            </a>
          </div>
        </div>
      </section>
    </div>

    <article class="media-page rtl-specimen__media" aria-labelledby="rtl-media-title">
      <header class="media-page__intro">
        <h1 id="rtl-media-title">מדיה</h1>
      </header>

      <section class="media-section media-section--lead" aria-labelledby="rtl-lead-title">
        <a
          class="media-lead"
          href={lead.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${lead.outlet}: ${lead.title}, נפתח בכרטיסייה חדשה`}
        >
          <div class="media-lead__visual">
            <ResponsiveMediaImage image={lead.image} sizes="(min-width: 70rem) 78rem, 100vw" />
            <span class="media-play" aria-hidden="true">▶</span>
          </div>
          <div class="media-lead__copy">
            <p class="media-outlet" lang="en" dir="ltr">{lead.outlet}</p>
            <h2 id="rtl-lead-title" lang="it" dir="auto">{lead.title}</h2>
            <p class="media-meta"><bdi>{lead.date} · {lead.meta}</bdi></p>
            <p class="media-lead__source"><bdi>RAI broadcast · YouTube</bdi></p>
          </div>
        </a>
      </section>

      <section class="media-section" aria-labelledby="rtl-screen-title">
        <h2 id="rtl-screen-title">על המסך</h2>
        <div class="media-grid media-grid--video">
          {videos.slice(0, 5).map((item) => <MediaVideoCard item={item} locale="he" />)}
        </div>
      </section>

      <section class="media-section" aria-labelledby="rtl-press-title">
        <h2 id="rtl-press-title">עיתונות</h2>
        <div class="media-grid media-grid--press">
          {press.slice(0, 2).map((item) => <MediaPressCard item={item} locale="he" />)}
        </div>
      </section>

      <section class="media-section" aria-labelledby="rtl-coverage-title">
        <h2 id="rtl-coverage-title">רשומות נוספות</h2>
        <div class="media-coverage-grid">
          {archive.slice(0, 2).map((item) => <MoreCoverageItem item={item} locale="he" />)}
        </div>
      </section>

      <details class="media-press-kit">
        <summary class="media-press-kit__summary">
          <span class="media-press-kit__title">ערכת עיתונות</span>
          <span class="media-press-kit__description">בדיקת disclosure מקומי בתוך RTL</span>
        </summary>
        <div class="media-press-kit__panel">
          <ul class="media-press-kit__resources">
            {
              pressKit.slice(0, 4).map((item) =>
                item.url ? (
                  <li>
                    <a
                      href={item.kind === 'download' ? publicPath(item.url) : item.url}
                      download={item.kind === 'download' ? '' : undefined}
                      target={item.kind === 'external' ? '_blank' : undefined}
                      rel={item.kind === 'external' ? 'noopener noreferrer' : undefined}
                    >
                      <span dir="auto">{item.label}</span>
                      <span class="media-meta" dir="auto">
                        {item.detail}
                      </span>
                      <span class="media-arrow" aria-hidden="true">
                        {item.kind === 'download' ? '↓' : '↗'}
                      </span>
                    </a>
                  </li>
                ) : (
                  <li class="media-press-kit__todo">
                    <span dir="auto">{item.label}</span>
                    <span class="media-meta" dir="auto">
                      {item.detail}
                    </span>
                  </li>
                )
              )
            }
          </ul>
        </div>
      </details>
    </article>
  </div>
</SiteShell>
