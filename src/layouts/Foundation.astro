---
import '../assets/styles/tailwind.css';

interface Props {
  lang: 'en' | 'he';
  dir: 'ltr' | 'rtl';
  title: string;
  description?: string;
  canonicalPath: string;
  alternatePath?: string;
  alternateLang?: 'en' | 'he';
  noindex?: boolean;
  socialImage?: {
    path: string;
    alt: string;
  };
}

const {
  lang,
  dir,
  title,
  description,
  canonicalPath,
  alternatePath,
  alternateLang,
  noindex = false,
  socialImage,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site) : undefined;
const xDefaultUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}en/`, Astro.site);
const socialImageUrl = socialImage ? new URL(socialImage.path, Astro.site) : undefined;
const shouldIncludeStructuredData = lang === 'en' && !noindex;
const structuredData = shouldIncludeStructuredData
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': `${xDefaultUrl.href}#person`,
          name: 'Dr. Lior Tabansky',
          url: xDefaultUrl.href,
          description: 'Independent work on innovation systems, AI, digital trust and national resilience.',
          knowsAbout: ['Innovation systems', 'Artificial intelligence', 'Digital trust', 'National resilience'],
        },
        {
          '@type': 'WebSite',
          '@id': `${xDefaultUrl.href}#website`,
          name: 'Dr. Lior Tabansky',
          url: xDefaultUrl.href,
          inLanguage: 'en',
          creator: { '@id': `${xDefaultUrl.href}#person` },
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl.href}#webpage`,
          name: title,
          url: canonicalUrl.href,
          ...(description ? { description } : {}),
          inLanguage: 'en',
          isPartOf: { '@id': `${xDefaultUrl.href}#website` },
          about: { '@id': `${xDefaultUrl.href}#person` },
        },
      ],
    }
  : undefined;
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f6f6" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {alternateUrl && alternateLang && <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      socialImageUrl && socialImage && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Dr. Lior Tabansky" />
          <meta property="og:locale" content="en_US" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:alt" content={socialImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          {description && <meta name="twitter:description" content={description} />}
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={socialImage.alt} />
        </>
      )
    }
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <slot />
  </body>
</html>
