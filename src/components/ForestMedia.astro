<script>
  const dialog = document.querySelector<HTMLDialogElement>('.proof-dialog');
  const image = dialog?.querySelector<HTMLImageElement>('.proof-full');
  const title = dialog?.querySelector<HTMLElement>('.proof-title');
  const close = dialog?.querySelector<HTMLButtonElement>('button');
  if (dialog && image && title && close) {
    close.classList.add('dialog-close');
    let trigger: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-proof]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        trigger = link;
        image.src = link.dataset.proof ?? link.href;
        image.alt = link.dataset.title ?? 'Enlarged article excerpt';
        title.textContent = image.alt;
        dialog.showModal();
      });
    });
    dialog.addEventListener('close', () => trigger?.focus());
  }
</script>
