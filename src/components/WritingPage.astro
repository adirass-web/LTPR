---
import SiteShell from '~/components/SiteShell.astro';
import { writingV3 } from '~/content/en-v3';
import type { Source } from '~/content/sources';
---

<SiteShell locale="en" page="writing">
  <article class="longform-page writing-page">
    <header class="writing-opening">
      <p class="eyebrow">Writing</p>
      <h1>{writingV3.opening.title}</h1>
      <p>{writingV3.opening.text}</p>
    </header>

    <section class="writing-section" aria-labelledby="essays-title">
      <div class="writing-section__header">
        <h2 id="essays-title">The essays</h2>
      </div>
      <ol class="essay-list">
        {
          writingV3.essays.map((essay) => (
            <li data-citation-slots={essay.citations.join('; ') || undefined}>
              <h3>{essay.title}</h3>
              <p>{essay.text}</p>
              <p class="essay-list__status">essay — coming</p>
              {essay.sources && (
                <ul class="citation-links" aria-label={`Sources for ${essay.title}`}>
                  {essay.sources.map((source: Source) => (
                    <li>
                      <a class="text-link" href={source.url}>
                        {source.label} <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="writing-section writing-section--book"
      aria-labelledby="book-title"
      data-citation-slots={writingV3.book.citations.join('; ')}
    >
      <div class="writing-section__header">
        <p class="eyebrow">The book</p>
        <h2 id="book-title">{writingV3.book.title}</h2>
      </div>
      <p>{writingV3.book.text}</p>
      <a class="text-link" href={writingV3.book.source.url}>SpringerLink <span aria-hidden="true">→</span></a>
    </section>

    <section class="writing-section" aria-labelledby="publications-title">
      <div class="writing-section__header">
        <h2 id="publications-title">Selected publications</h2>
      </div>
      <ul class="publication-list">
        {
          writingV3.publications.map((publication) => (
            <li>
              <a href={publication.source.url}>
                {publication.title} <span aria-hidden="true">→</span>
              </a>{' '}
              — {publication.publication}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</SiteShell>
