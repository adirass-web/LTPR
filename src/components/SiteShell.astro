---
import Foundation from '~/layouts/Foundation.astro';
import { launchPageKeys, pagePath, siteContent, type Locale, type PageKey } from '~/content/site';

interface Props {
  locale: Locale;
  page: PageKey;
  home?: boolean;
  canonicalPath?: string;
  alternatePath?: string;
  showLanguageSwitch?: boolean;
  noindex?: boolean;
}

const {
  locale,
  page,
  home = false,
  canonicalPath,
  alternatePath,
  showLanguageSwitch = false,
  noindex = false,
} = Astro.props;
const alternateLocale = locale === 'en' ? 'he' : 'en';
const content = siteContent[locale];
const current = content.pages[page];
const dir = locale === 'he' ? 'rtl' : 'ltr';
const path = canonicalPath ?? pagePath(locale, page);
const alternate = showLanguageSwitch ? (alternatePath ?? pagePath(alternateLocale, page)) : undefined;
const navItems =
  locale === 'en'
    ? [
        {
          label: content.pages.home.nav,
          href: `${pagePath('en', 'home')}#profile`,
          current: page === 'home',
        },
        {
          label: content.pages.media.nav,
          href: pagePath('en', 'media'),
          current: page === 'media',
        },
      ]
    : launchPageKeys.map((item) => ({
        label: content.pages[item].nav,
        href: pagePath(locale, item),
        current: item === page,
      }));
---

<Foundation
  lang={locale}
  dir={dir}
  title={current.title}
  description={current.description}
  canonicalPath={path}
  alternatePath={alternate}
  alternateLang={alternate ? alternateLocale : undefined}
  noindex={noindex}
>
  <a class="skip-link" href="#content">{locale === 'he' ? 'דלג לתוכן' : 'Skip to content'}</a>
  <header class="site-header">
    <nav class="site-nav" aria-label={locale === 'he' ? 'ניווט ראשי' : 'Primary navigation'}>
      <a class="site-name" href={pagePath(locale, 'home')}><bdi>Dr. Lior Tabansky</bdi></a>
      <details class="site-nav__menu" open>
        <summary>{locale === 'he' ? 'תפריט' : 'Menu'}</summary>
        <ul class="site-nav__links">
          {
            navItems.map((item) => (
              <li>
                <a aria-current={item.current ? 'page' : undefined} href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            alternate && (
              <li>
                <a
                  class="site-nav__locale"
                  href={alternate}
                  lang={alternateLocale}
                  dir={alternateLocale === 'he' ? 'rtl' : 'ltr'}
                >
                  {content.switchLabel}
                </a>
              </li>
            )
          }
        </ul>
      </details>
    </nav>
  </header>
  <main id="content" tabindex="-1" class:list={['site-main', { 'site-main--home': home }]}>
    <slot />
  </main>
  <footer id="inquiries" class="site-footer">
    <div class="site-footer__inner">
      <bdi>Dr. Lior Tabansky</bdi>
      {
        locale === 'en' ? (
          <a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com</a>
        ) : (
          <div>
            <p>{content.privateInquiries}</p>
            <a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com</a>
          </div>
        )
      }
    </div>
  </footer>
</Foundation>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.site-nav__menu');
  const compactViewport = window.matchMedia('(max-width: 52.5rem)');

  if (menu) {
    const synchronizeMenu = () => {
      menu.open = !compactViewport.matches;
    };

    synchronizeMenu();
    compactViewport.addEventListener('change', synchronizeMenu);
  }
</script>
