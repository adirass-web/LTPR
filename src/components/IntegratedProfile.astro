---
import BookCover from '~/components/BookCover.astro';
import { sources } from '~/content/sources';
import '~/assets/styles/narrative-review.css';
import '~/assets/styles/profile-revision.css';

const base = import.meta.env.BASE_URL;
const recordPath = `${base}en/media/`;
const portraitRoot = `${base}images/portraits/lior-tabansky-portrait-2x3`;
const portraitSet = (format: string) =>
  [480, 720, 1024].map((width) => `${portraitRoot}-${width}.${format} ${width}w`).join(', ');
---

<div class="nl-surface profile-revision">
  <a class="nl-skip" href="#content">Skip to content</a>
  <header class="nl-header">
    <a href="#profile">Dr. Lior Tabansky</a>
    <a href={recordPath}>Research &amp; public record</a>
  </header>
  <main id="content" class="nl-page" tabindex="-1">
    <section id="profile" class="nl-opening" aria-labelledby="profile-title">
      <div class="nl-identity">
        <div class="profile-identity-copy">
          <h1 id="profile-title">Dr. Lior Tabansky</h1>
          <p class="nl-category">Strategic technology adviser</p>
        </div>
        <figure class="nl-portrait">
          <picture>
            <source type="image/avif" srcset={portraitSet('avif')} sizes="(min-width: 800px) 216px, 160px" />
            <source type="image/webp" srcset={portraitSet('webp')} sizes="(min-width: 800px) 216px, 160px" />
            <img
              src={`${portraitRoot}-480.jpg`}
              srcset={portraitSet('jpg')}
              sizes="(min-width: 800px) 216px, 160px"
              width="1024"
              height="1536"
              alt="Dr. Lior Tabansky"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </figure>
      </div>
      <p class="nl-intro">
        I solve problems in cybersecurity, AI and critical infrastructure with and within enterprises and public
        institutions. My work spans advanced and emerging economies, including assignments undertaken with the World
        Bank.
      </p>
      <div class="profile-record-intro">
        <p>Much of my work is private. These accounts and my public record offer a window onto it.</p>
        <ul class="nl-public-records" aria-label="Selected public records">
          <li>
            <a href={sources.sectoralCybersecurityMaturityModel.url} target="_blank" rel="noopener noreferrer"
              >World Bank · Cyber-resilience research<span class="sr-only">, opens in a new tab</span> ↗</a
            >
          </li>
          <li>
            <a
              href="https://www.ft.dk/aktuelt/nyheder/2019/09/20190911-fou-militaer-cybersikkerhed"
              target="_blank"
              rel="noopener noreferrer"
              >Danish Parliament · Expert hearing<span class="sr-only">, opens in a new tab</span> ↗</a
            >
          </li>
          <li>
            <a
              href="https://apnews.com/article/technology-middle-east-iran-dubai-b0404963ae23e5008439a0b607952de1"
              target="_blank"
              rel="noopener noreferrer"
              >Associated Press · International reporting<span class="sr-only">, opens in a new tab</span> ↗</a
            >
          </li>
        </ul>
        <a class="nl-archive" href={recordPath}>Publications, media and international forums →</a>
      </div>
    </section>

    <section class="nl-work" aria-labelledby="work-title">
      <h2 id="work-title">Selected public work</h2>
      <div class="nl-records">
        <article>
          <p class="nl-eyebrow">National cybersecurity strategy</p>
          <h3>Singapore</h3>
          <p>
            I helped a new national cybersecurity agency define its vision and strategic choices—including what not to
            do—so cybersecurity would advance digital transformation and wider national priorities.
          </p>
          <a
            class="profile-evidence-link"
            href={sources.strategicAdvisoryRecord.url}
            target="_blank"
            rel="noopener noreferrer">University record of the research and advisory work ↗</a
          >
        </article>
        <article>
          <p class="nl-eyebrow">World Bank / PROGRESS</p>
          <h3>Four sectors across 11 countries</h3>
          <p>
            With colleagues, I developed PROGRESS to build cyber resilience across whole sectors. We applied and refined
            it alongside local teams; the resulting recommendations are being implemented.
          </p>
          <a class="profile-evidence-link" href={`${recordPath}#critical-infrastructure`}
            >Read the paper and field record →</a
          >
        </article>
      </div>
    </section>

    <section class="profile-applied" aria-labelledby="applied-title">
      <div class="profile-section-heading">
        <p class="nl-eyebrow">Applied work</p>
        <h2 id="applied-title">Keeping power engineers in charge</h2>
      </div>
      <div class="profile-story">
        <p>
          The engineers responsible for generating, transmitting and distributing electricity were resisting a proposed
          cyber unit staffed by outsiders. They would still answer for the power supply, while the new unit would change
          how they operated it.
        </p>
        <p>
          A new national cyber agency brought me in as a foreign expert to get protection moving. I drew on local
          interviews, focus groups and knowledge of electricity and cyber practices elsewhere. My recommendation was to
          keep the power engineers in charge, with cyber specialists working alongside them.
        </p>
        <p>
          The engineers helped devise tools, workarounds and operating changes, and checked the risks to electricity
          service. Within weeks, the sector accepted my directions. Their involvement removed the internal opposition
          that threatened progress. The approach also avoided the cost of establishing and staffing a separate unit and
          duplicating systems.
        </p>
        <p>
          Cyber specialists then implemented measures that let them see data and processes across industrial control
          systems and IT. They could study the activity together, learn what normal operation looked like, flag
          anomalies and raise alerts. That gave them a way to measure what was happening and decide what to improve.
        </p>
        <a class="profile-evidence-link" href={`${recordPath}#critical-infrastructure`}
          >Related work on critical-infrastructure resilience →</a
        >
      </div>
    </section>

    <section class="nl-thinking" aria-labelledby="research-title">
      <div class="nl-thinking-row">
        <div class="nl-thinking-heading">
          <p class="nl-eyebrow">Research and perspective</p>
          <h2 id="research-title">Innovation, defense and warfare</h2>
        </div>
        <div class="nl-thinking-body">
          <p>
            Alongside advisory work, I research <a class="profile-inline-link" href={`${recordPath}#innovation`}
              >innovation</a
            >,
            <a class="profile-inline-link" href={`${recordPath}#cybered-conflict`}>defense and warfare</a>. My published
            work on <a class="profile-inline-link" href={`${recordPath}#cybered-conflict`}>cybered conflict</a> examines the
            relationship between technological means, strategic objectives and institutions.
          </p>
          <p>I also study what can be transferred from Israel’s cyber experience and what cannot.</p>
          <a class="nl-book" href={`${recordPath}#innovation`}>
            <BookCover alt="Cover of Cybersecurity in Israel by Lior Tabansky and Isaac Ben-Israel" />
            <span><span>Cybersecurity in Israel</span><small>Springer, with Isaac Ben-Israel →</small></span>
          </a>
          <a class="nl-affiliation" href={sources.cyberResilienceLabTeam.url} target="_blank" rel="noopener noreferrer"
            >Head, Cyber Resilience Laboratory<br />Tel Aviv University ↗</a
          >
        </div>
      </div>
    </section>
  </main>
  <footer class="nl-footer">
    <span>Dr. Lior Tabansky</span><a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com ↗</a>
  </footer>
</div>
