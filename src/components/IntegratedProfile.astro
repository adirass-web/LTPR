---
import BookCover from '~/components/BookCover.astro';
import { homeV3 } from '~/content/en-v3';
import { sources } from '~/content/sources';
import '~/assets/styles/narrative-review.css';

const portraitRoot = `${import.meta.env.BASE_URL}images/portraits/lior-tabansky-portrait-2x3`;
const portraitSet = (format: string) =>
  [480, 720, 1024].map((width) => `${portraitRoot}-${width}.${format} ${width}w`).join(', ');
---

<div class="nl-surface">
  <a class="nl-skip" href="#content">Skip to content</a>
  <header class="nl-header"><a href="#content">Dr. Lior Tabansky</a></header>
  <main id="content" class="nl-page" tabindex="-1">
    <section class="nl-opening" aria-labelledby="profile-title">
      <p class="nl-category">{homeV3.hero.category}</p>
      <div class="nl-identity">
        <h1 id="profile-title">{homeV3.hero.title}</h1>
        <figure class="nl-portrait">
          <picture>
            <source type="image/avif" srcset={portraitSet('avif')} sizes="(min-width: 800px) 216px, 160px" />
            <source type="image/webp" srcset={portraitSet('webp')} sizes="(min-width: 800px) 216px, 160px" />
            <img
              src={`${portraitRoot}-480.jpg`}
              srcset={portraitSet('jpg')}
              sizes="(min-width: 800px) 216px, 160px"
              width="1024"
              height="1536"
              alt="Dr. Lior Tabansky"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </figure>
      </div>
      <p class="nl-intro">
        I work with governments and institutions to turn difficult technology and security problems into capabilities
        that work.
      </p>
    </section>

    <section class="nl-work" aria-labelledby="work-title">
      <h2 id="work-title">Selected work</h2>
      <div class="nl-records">
        <article>
          <a class="nl-eyebrow" href={sources.progressFieldRecord.url} target="_blank" rel="noopener noreferrer"
            >World Bank / PROGRESS ↗</a
          >
          <h3>Four critical sectors across 11 countries</h3>
          <p>
            Energy, healthcare, digital infrastructure and financial services. The 2025 field record describes the
            tailored recommendations as being implemented.
          </p>
        </article>
        <article>
          <a class="nl-eyebrow" href={sources.strategicAdvisoryRecord.url} target="_blank" rel="noopener noreferrer"
            >Strategic advisory ↗</a
          >
          <h3>National cybersecurity strategy</h3>
          <p>
            Research and analysis developed into a strategic vision, guiding principles and tailored policy
            recommendations.
          </p>
        </article>
      </div>
      <p class="nl-work-note">Almost all of my work is not public. These records are a small public window onto it.</p>
    </section>

    <section class="nl-thinking" aria-label="Perspective and method">
      <div class="nl-thinking-row">
        <div class="nl-thinking-heading">
          <p class="nl-eyebrow">Perspective</p>
          <h2 id="systems-title">Technology is only part of the system.</h2>
        </div>
        <div class="nl-thinking-body">
          <p>
            National cyber capability is more than a strategy document. It depends on institutions able to set
            priorities, coordinate responsibility and sustain action.
          </p>
          <p>
            Israel’s cyber advantage grew through connections between government, industry and universities. My work
            examines what can be transferred from that experience—and what cannot.
          </p>
          <a class="nl-book" href={homeV3.israelExperience.book.url} target="_blank" rel="noopener noreferrer">
            <BookCover alt={homeV3.israelExperience.book.alt} />
            <span
              ><span>{homeV3.israelExperience.book.title}</span><small>{homeV3.israelExperience.book.detail} ↗</small
              ></span
            >
          </a>
          <a class="nl-affiliation" href={homeV3.hero.role.url} target="_blank" rel="noopener noreferrer"
            >{homeV3.hero.role.title}<br />{homeV3.hero.role.institution} ↗</a
          >
        </div>
      </div>
      <div class="nl-thinking-row">
        <div class="nl-thinking-heading">
          <p class="nl-eyebrow">AI / strategic method</p>
          <h2 id="decisions-title">Start with the decision.</h2>
        </div>
        <div class="nl-thinking-body">
          <p>{homeV3.work.areas[1].description}</p>
        </div>
      </div>
    </section>

    <section class="nl-closing" aria-label="Approach and public record">
      <p class="nl-method">{homeV3.method.paragraphs[0]}</p>
      <p class="nl-principle">{homeV3.method.paragraphs[1]}</p>
      <a class="nl-archive" href={`${import.meta.env.BASE_URL}en/media/`}>Media &amp; international record ↗</a>
    </section>
  </main>
  <footer class="nl-footer">
    <span>Dr. Lior Tabansky</span><a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com ↗</a>
  </footer>
</div>
