---
import Portrait from '~/components/Portrait.astro';
import SiteShell from '~/components/SiteShell.astro';
import { homeV3 } from '~/content/en-v3';
---

<SiteShell locale="en" page="home" home>
  <div class="home home--v3">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="eyebrow">{homeV3.hero.eyebrow}</p>
          <h1 id="home-title">{homeV3.hero.title}</h1>
          {homeV3.hero.subhead.split('\n\n').map((paragraph) => (
            <p class="home-hero__standfirst">{paragraph}</p>
          ))}
          <a class="cta cta--accent" href="#inquiries">Private inquiries <span aria-hidden="true">→</span></a>
        </div>
        <Portrait variant="2x3" alt="Dr. Lior Tabansky" priority />
      </div>
    </section>

    <section class="home-section home-section--pillars" aria-labelledby="problems-title">
      <div class="home-section__header">
        <h2 id="problems-title">{homeV3.problemsTitle}</h2>
      </div>
      <ol class="pillar-list">
        {
          homeV3.problems.map((problem, index) => (
            <li data-citation-slots={problem.citations.join('; ') || undefined}>
              <span aria-hidden="true">0{index + 1}</span>
              <div>
                <h3>{problem.title}</h3>
                {problem.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-section home-section--proof" aria-labelledby="proof-title">
      <p class="eyebrow">Twenty years, briefly</p>
      <ul id="proof-title" class="quiet-proof">
        {homeV3.proof.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="home-close" aria-labelledby="inquiries-title">
      <div>
        <p class="eyebrow">Private inquiries</p>
        <h2 id="inquiries-title">{homeV3.close}</h2>
      </div>
      <a class="cta cta--outline" href="mailto:liortabansky@gmail.com">liortabansky@gmail.com</a>
    </section>
  </div>
</SiteShell>
