---
import Portrait from '~/components/Portrait.astro';
import ResponsiveMediaImage from '~/components/media/ResponsiveMediaImage.astro';
import SiteShell from '~/components/SiteShell.astro';
import { homeV3 } from '~/content/en-v3';
import { pagePath } from '~/content/site';
import { lead } from '~/data/media';
import '~/assets/styles/profile.css';
---

<SiteShell
  locale="en"
  page="home"
  home
  socialImage={{
    path: 'images/portraits/lior-tabansky-portrait-2x3-1024.jpg',
    alt: 'Dr. Lior Tabansky',
  }}
>
  <div class="home">
    <section id="profile" class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <h1 id="home-title">{homeV3.hero.title}</h1>
          <p class="home-hero__standfirst">{homeV3.hero.standfirst}</p>
        </div>
        <Portrait variant="2x3" alt="Dr. Lior Tabansky" priority />
      </div>
    </section>

    <section class="profile-section profile-section--areas" aria-labelledby="work-title">
      <div class="profile-section__header">
        <h2 id="work-title">{homeV3.workTitle}</h2>
      </div>
      <ul class="profile-area-list">
        {
          homeV3.areas.map((area) => (
            <li data-citation-slots={area.citations.join('; ') || undefined}>
              <h3>{area.title}</h3>
              <div class="profile-area-list__copy">
                {area.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="profile-evidence" aria-labelledby="record-title">
      <div class="profile-evidence__record">
        <h2 id="record-title">{homeV3.record.title}</h2>
        <ul class="profile-record-list">
          {homeV3.record.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div
        class="profile-evidence__method"
        aria-labelledby="method-title"
        data-citation-slots={homeV3.method.citations.join('; ')}
      >
        <h2 id="method-title">{homeV3.method.title}</h2>
        <div class="profile-prose">
          {homeV3.method.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="profile-close" aria-labelledby="public-record-title">
      <div class="profile-close__inner">
        <h2 id="public-record-title">{homeV3.publicRecord.title}</h2>
        <div class="profile-close__body">
          <div class="profile-close__copy">
            <p>{homeV3.publicRecord.description}</p>
            <a class="text-link" href={pagePath('en', 'media')}>{homeV3.publicRecord.linkLabel}</a>
          </div>
          <a class="profile-close__visual" href={pagePath('en', 'media')} aria-label="View the Media page">
            <ResponsiveMediaImage image={lead.image} sizes="(min-width: 64rem) 42vw, 100vw" />
          </a>
        </div>
      </div>
    </section>
  </div>
</SiteShell>
