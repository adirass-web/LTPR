---
import BookCover from '~/components/BookCover.astro';
import Portrait from '~/components/Portrait.astro';
import ResponsiveMediaImage from '~/components/media/ResponsiveMediaImage.astro';
import SiteShell from '~/components/SiteShell.astro';
import { homeV3 } from '~/content/en-v3';
import { pagePath } from '~/content/site';
import { lead } from '~/data/media';
import '~/assets/styles/profile.css';
---

<SiteShell
  locale="en"
  page="home"
  home
  socialImage={{
    path: 'images/portraits/lior-tabansky-portrait-2x3-1024.jpg',
    alt: 'Dr. Lior Tabansky',
  }}
>
  <div class="home">
    <section id="profile" class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-hero__category">{homeV3.hero.category}</p>
          <h1 id="home-title">{homeV3.hero.title}</h1>
          <p class="home-hero__standfirst">{homeV3.hero.standfirst}</p>
          <a
            class="home-hero__role"
            href={homeV3.hero.role.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${homeV3.hero.role.title}, ${homeV3.hero.role.institution}, opens in a new tab`}
          >
            <span>{homeV3.hero.role.title}</span>
            <span aria-hidden="true">·</span>
            <span>{homeV3.hero.role.institution}</span>
          </a>
        </div>
        <Portrait variant="2x3" alt="Dr. Lior Tabansky" priority />
      </div>
    </section>

    <section class="profile-section profile-section--proof" aria-labelledby="public-work-title">
      <div class="profile-section__header">
        <h2 id="public-work-title">{homeV3.publicWork.title}</h2>
      </div>
      <div class="profile-proof">
        <ul class="profile-proof-list">
          {
            homeV3.publicWork.items.map((item) => (
              <li data-citation-slots={item.citations.join('; ')}>
                <p class="profile-proof__label">{item.label}</p>
                <h3>{item.title}</h3>
                <p class="profile-proof__description">{item.description}</p>
                <a
                  class="profile-proof__source"
                  href={item.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.sourceLabel}, opens in a new tab`}
                >
                  {item.sourceLabel}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="profile-proof__disclosure">{homeV3.publicWork.disclosure}</p>
      </div>
    </section>

    <section
      class="profile-section profile-section--israel"
      aria-labelledby="israel-title"
      data-citation-slots={homeV3.israelExperience.citations.join('; ')}
    >
      <div class="profile-section__header">
        <h2 id="israel-title">{homeV3.israelExperience.title}</h2>
      </div>
      <div class="profile-israel">
        <figure class="profile-book">
          <a
            class="profile-book__link"
            href={homeV3.israelExperience.book.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${homeV3.israelExperience.book.title} on Springer, opens in a new tab`}
          >
            <BookCover alt={homeV3.israelExperience.book.alt} />
            <figcaption>
              <cite>{homeV3.israelExperience.book.title}</cite>
              <span>{homeV3.israelExperience.book.detail}</span>
            </figcaption>
          </a>
        </figure>
        <div class="profile-israel__copy">
          {homeV3.israelExperience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="profile-section profile-section--work" aria-labelledby="work-title">
      <div class="profile-section__header">
        <h2 id="work-title">{homeV3.work.title}</h2>
      </div>
      <ul class="profile-work-list">
        {
          homeV3.work.areas.map((area) => (
            <li data-citation-slots={area.citations.join('; ') || undefined}>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="profile-section profile-section--method"
      aria-labelledby="method-title"
      data-citation-slots={homeV3.method.citations.join('; ')}
    >
      <div class="profile-section__header">
        <h2 id="method-title">{homeV3.method.title}</h2>
      </div>
      <div class="profile-method">
        <p>{homeV3.method.paragraphs[0]}</p>
        <p class="profile-method__principle">{homeV3.method.paragraphs[1]}</p>
      </div>
    </section>

    <section class="profile-close" aria-labelledby="public-record-title">
      <div class="profile-close__inner">
        <h2 id="public-record-title">{homeV3.publicRecord.title}</h2>
        <div class="profile-close__body">
          <div class="profile-close__copy">
            <p>{homeV3.publicRecord.description}</p>
            <a class="text-link" href={pagePath('en', 'media')}>{homeV3.publicRecord.linkLabel}</a>
          </div>
          <a class="profile-close__visual" href={pagePath('en', 'media')} aria-label="View the Media page">
            <ResponsiveMediaImage image={lead.image} sizes="(min-width: 64rem) 42vw, 100vw" />
          </a>
        </div>
      </div>
    </section>
  </div>
</SiteShell>
