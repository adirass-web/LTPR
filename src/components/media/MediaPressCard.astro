---
import type { MediaPrestigePressItem } from '~/data/mediaPrestige';
import ResponsiveMediaImage from './ResponsiveMediaImage.astro';

interface Props {
  item: MediaPrestigePressItem;
}

const { item } = Astro.props;
---

<article class="media-card media-card--press">
  <a
    class="media-card__link"
    href={item.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Read ${item.title} in ${item.outlet}, opens in a new tab`}
  >
    <div class="media-card__press-visual">
      {
        item.image ? (
          <ResponsiveMediaImage image={item.image} sizes="(min-width: 64rem) 55vw, 100vw" />
        ) : (
          <span class="media-card__poster-label">{item.visualLabel ?? item.outlet}</span>
        )
      }
    </div>
    <div class="media-card__body">
      <p class="eyebrow">{item.outlet}</p>
      <h3 lang={item.originalLang}>{item.title}</h3>
      <p class="media-meta">{item.date}</p>
    </div>
  </a>
</article>
