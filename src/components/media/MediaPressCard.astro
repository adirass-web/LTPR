---
import type { MediaPrestigePressItem } from '~/data/mediaPrestige';
import ResponsiveMediaImage from './ResponsiveMediaImage.astro';
import MediaSourceContext from './MediaSourceContext.astro';
import type { Locale } from '~/content/site';

interface Props {
  item: MediaPrestigePressItem;
  locale?: Locale;
}

const { item, locale = 'en' } = Astro.props;
const titleLang = item.originalLang ?? 'en';
const accessibleLabel =
  locale === 'he'
    ? `${item.outlet}: ${item.title}, נפתח בכרטיסייה חדשה`
    : `Read ${item.title} in ${item.outlet}, opens in a new tab`;
---

<article class="media-card media-card--press">
  <div class="media-card__link">
    <a
      class="media-card__press-visual"
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={accessibleLabel}
    >
      {
        item.image ? (
          <ResponsiveMediaImage image={item.image} sizes="(min-width: 64rem) 55vw, 100vw" />
        ) : (
          <span class="media-card__poster-label">{item.visualLabel ?? item.outlet}</span>
        )
      }
    </a>
    <div class="media-card__body">
      <p class="eyebrow" lang="en" dir="ltr">{item.outlet}</p>
      <h3 lang={titleLang} dir="auto">
        <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={accessibleLabel}>{item.title}</a>
      </h3>
      <p class="media-meta"><bdi>{item.date}</bdi></p>
      {locale === 'en' && <MediaSourceContext outlet={item.outlet} />}
    </div>
  </div>
</article>
