---
import type { MediaImage } from '~/data/media';

interface Props {
  image: MediaImage;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { image, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
const asset = (file: string) => `${import.meta.env.BASE_URL}images/media/${file}`;
---

<img
  src={asset(image.src)}
  width={image.width}
  height={image.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  alt={image.alt}
/>
