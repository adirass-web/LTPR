---
import ResponsiveMediaImage from './ResponsiveMediaImage.astro';
import type { MediaVideoItem } from '~/data/media';
import type { Locale } from '~/content/site';

interface Props {
  item: MediaVideoItem;
  locale?: Locale;
}

const { item, locale = 'en' } = Astro.props;
const Wrapper = item.url ? 'a' : 'div';
const titleLang = item.originalLang ?? 'en';
const accessibleLabel =
  locale === 'he'
    ? `${item.outlet}: ${item.title}, נפתח בכרטיסייה חדשה`
    : `Watch ${item.title} from ${item.outlet}, opens in a new tab`;
const wrapperProps = item.url
  ? {
      href: item.url,
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': accessibleLabel,
    }
  : {};
---

<article class="media-card media-card--video">
  <Wrapper class:list={['media-card__link', { 'media-card__link--static': !item.url }]} {...wrapperProps}>
    <div class="media-card__visual">
      {
        item.image ? (
          <ResponsiveMediaImage image={item.image} sizes="(min-width: 64rem) 58vw, (min-width: 48rem) 50vw, 100vw" />
        ) : (
          <div class="media-card__poster-label">{item.posterLabel}</div>
        )
      }
      {
        item.url && (
          <span class="media-play" aria-hidden="true">
            ▶
          </span>
        )
      }
    </div>
    <div class="media-card__body">
      <p class="eyebrow" lang="en" dir="ltr">{item.outlet}</p>
      <h3 lang={titleLang} dir="auto">{item.title}</h3>
      <p class="media-meta"><bdi>{item.date}{item.meta ? ` · ${item.meta}` : ''}</bdi></p>
    </div>
  </Wrapper>
</article>
