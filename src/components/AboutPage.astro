---
import Portrait from '~/components/Portrait.astro';
import SiteShell from '~/components/SiteShell.astro';
import { aboutV3 } from '~/content/en-v3';
---

<SiteShell locale="en" page="about">
  <article class="longform-page about-page">
    <header class="longform-opening">
      <div>
        <p class="eyebrow">About</p>
        <h1>{aboutV3.opening.title}</h1>
        {aboutV3.opening.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <Portrait variant="square" alt="Dr. Lior Tabansky" />
    </header>

    <div class="longform-sections">
      {
        aboutV3.sections.map((section, index) => (
          <section
            class="longform-section"
            aria-labelledby={`about-section-${index + 1}`}
            data-citation-slots={section.citations.join('; ') || undefined}
          >
            <div class="longform-section__label">
              <p class="section-index" aria-hidden="true">
                0{index + 1}
              </p>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2 id={`about-section-${index + 1}`}>{section.label}</h2>
            </div>
            <div class="longform-section__copy">
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.label === 'On discretion' && (
                <a class="text-link" href="mailto:liortabansky@gmail.com">
                  Private inquiries <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</SiteShell>
