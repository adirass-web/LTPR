---
import SiteShell from '~/components/SiteShell.astro';
import { pagePath } from '~/content/site';

const profilePath = `${pagePath('en', 'home')}#profile`;
---

<SiteShell locale="en" page="about" canonicalPath={pagePath('en', 'home')} noindex>
  <section class="route-note" aria-labelledby="route-note-title">
    <h1 id="route-note-title">Profile</h1>
    <p>The full profile is now on the home page.</p>
    <a class="text-link" href={profilePath}>View profile <span aria-hidden="true">→</span></a>
  </section>
</SiteShell>
