---
import '~/assets/styles/cinematic-profile.css';
const base = import.meta.env.BASE_URL;
interface Props {
  recordPath?: string;
  bookSrc?: string;
  compact?: boolean;
}
const compact = Astro.props.compact ?? false;
const recordPath = Astro.props.recordPath ?? `${base}en/media/`;
const bookSrc =
  Astro.props.bookSrc ?? 'https://media.springernature.com/full/springer-static/cover-hires/book/978-3-319-18986-4';
---

<div class="cinematic-profile option-b combined">
  <a class="skip" href="#content">Skip to content</a><header class="profile-masthead">
    <a class="brand" href="#top" aria-label="Dr. Lior Tabansky — return to top">Dr. Lior Tabansky</a>
  </header><main id="content">
    <section class="hero" id="top">
      <figure class="visual hero-image">
        <img
          src={`${base}images/ambient/city-night-1920.webp`}
          srcset={`${base}images/ambient/city-night-960.webp 960w, ${base}images/ambient/city-night-1920.webp 1920w, ${base}images/ambient/city-night-2560.webp 2560w`}
          sizes="(max-aspect-ratio: 20/9) 223vh, 100vw"
          width="4096"
          height="1840"
          fetchpriority="high"
          alt="Night panorama of a city"
        />
      </figure><div class="hero-inner">
        <div class="hero-heading">
          <p class="profile-kicker">Strategic technology adviser</p><h1>Dr. Lior<br />Tabansky</h1>
        </div><p class="hero-intro">
          I solve problems in cybersecurity, AI and critical infrastructure with and within enterprises and public
          institutions. My work spans advanced and emerging economies, including assignments undertaken with the World
          Bank.
        </p><div class="hero-links">
          <a class="scroll-cue" href="#profile">Explore ↓</a><a href={recordPath}
            >Publications, media and international forums ↗</a
          >
        </div>
        {
          compact && (
            <ul class="hero-evidence" aria-label="Selected public work">
              <li>
                <a href="#work">
                  <>
                    <span>Singapore</span>
                    <span>National cybersecurity strategy →</span>
                  </>
                </a>
              </li>
              <li>
                <a href={`${recordPath}#critical-infrastructure`}>
                  <>
                    <span>World Bank</span>
                    <span>Four sectors across 11 countries →</span>
                  </>
                </a>
              </li>
            </ul>
          )
        }
      </div>
    </section><section id="profile" class="profile wrap">
      <div class="portrait">
        <img
          src={`${base}images/portraits/lior-tabansky-portrait-2x3-720.webp`}
          loading="lazy"
          alt="Dr. Lior Tabansky"
          width="1024"
          height="1536"
        /><span class="caption">Dr. Lior Tabansky</span>
      </div><div class="profile-copy">
        <p class="privacy">
          Much of my work is private. These accounts and my public record offer a window onto it.
        </p><ul class="evidence">
          <li>
            <a href="https://documents.worldbank.org/en/publication/documents-reports/documentdetail/099062623085028392"
              >World Bank · Cyber-resilience research ↗</a
            >
          </li><li>
            <a href="https://www.ft.dk/aktuelt/nyheder/2019/09/20190911-fou-militaer-cybersikkerhed"
              >Danish Parliament · Expert hearing ↗</a
            >
          </li><li>
            <a href="https://apnews.com/article/technology-middle-east-iran-dubai-b0404963ae23e5008439a0b607952de1"
              >Associated Press · International reporting ↗</a
            >
          </li>
        </ul><a class="textlink" href={recordPath}>Publications, media and international forums →</a>
      </div><figure class="visual profile-ambient">
        <img
          src={`${base}images/ambient/wooded-island-1920.webp`}
          srcset={`${base}images/ambient/wooded-island-960.webp 960w, ${base}images/ambient/wooded-island-1920.webp 1920w`}
          sizes="(min-width: 761px) 75vw, 134vw"
          width="3137"
          height="1651"
          loading="lazy"
          alt="A wooded island reflected in still water"
        />
      </figure>
    </section><section id="work" class="work wrap">
      <div class="section-label"><span>01</span><h2>Selected public work</h2></div><div class="engagements">
        <article>
          <p class="profile-kicker">National cybersecurity strategy</p><h3>Singapore</h3><p>
            I helped a new national cybersecurity agency define its vision and strategic choices—including what not to
            do—so cybersecurity would advance digital transformation and wider national priorities.
          </p><a
            class="textlink small"
            href="https://www.csa.gov.sg/resources/publications/singapore-s-cybersecurity-strategy-2016/"
            >Singapore’s Cybersecurity Strategy 2016 · CSA ↗</a
          >
        </article><article>
          <p class="profile-kicker">World Bank / PROGRESS</p><h3>
            Four sectors across<br class="desktop" /> 11 countries
          </h3><p>
            With colleagues, I developed PROGRESS to build cyber resilience across whole sectors. We applied and refined
            it alongside local teams; the resulting recommendations are being implemented.
          </p><a class="textlink small" href={`${recordPath}#critical-infrastructure`}
            >Read the paper and field record →</a
          >
        </article>
      </div>
    </section><section id="applied" class="applied">
      <div class="wrap">
        <div class="section-label"><span>02</span><p>Applied work</p></div><div class="story-heading">
          <h2>Keeping power<br />engineers<br />in charge</h2><figure class="story-note">
            <blockquote>“Within weeks, the sector accepted my recommendations.”</blockquote><figcaption>
              From the account below
            </figcaption>
          </figure>
        </div><div class="story-body">
          <p class="story-lead">
            The power engineers were responsible for keeping electricity flowing. A proposed cyber unit, staffed by
            outsiders, would change how they ran it while leaving them answerable for the supply. Their resistance had a
            practical reason.
          </p><p class="">
            A new national cyber agency brought me in as a foreign expert to help start critical-infrastructure
            protection in the electricity sector. I studied local arrangements through interviews and focus groups,
            drawing on electricity and cyber practices in other countries. My recommendation was to keep the engineers
            in charge and have cyber specialists work alongside them.
          </p><p class="">
            The engineers helped devise tools, workarounds and operating changes, and reviewed the risks to electricity
            service. Within weeks, the sector accepted my recommendations. Their involvement removed the internal
            opposition that had threatened progress. It also avoided the cost of establishing and staffing a separate
            unit and duplicating systems.
          </p><p class="">
            Cyber specialists implemented tools that made data and processes visible across industrial control systems
            and IT. They could compare activity across both, establish what normal operation looked like, and flag
            anomalies or raise alerts. This gave them a basis for measuring performance and deciding what to improve.
          </p><a class="textlink small" href={`${recordPath}#critical-infrastructure`}
            >Related work on critical-infrastructure resilience →</a
          >
        </div>
      </div>
    </section><section id="research" class="research wrap">
      <div class="section-label"><span>03</span><p>Research and perspective</p></div><div class="research-grid">
        <div class="research-title">
          <h2>Innovation,<br />defense<br />and warfare</h2><a class="book" href={`${recordPath}#innovation`}
            ><img
              class="actual-book"
              src={bookSrc}
              loading="lazy"
              alt="Cover of Cybersecurity in Israel by Lior Tabansky and Isaac Ben-Israel"
              width="827"
              height="1254"
            /><span>Cybersecurity in Israel<small>Springer, with Isaac Ben-Israel →</small></span></a
          >
        </div><div class="research-copy">
          <p class="lead">
            Alongside advisory work, I research <a href={`${recordPath}#innovation`}>innovation</a>, <a
              href={`${recordPath}#cybered-conflict`}>defense and warfare</a
            >.
          </p><p>
            My defense research examines why states with advanced technology and well-funded armed forces still leave
            civilian infrastructure exposed to destructive cyberattacks. I argue that AI, robotics and geopolitical
            disorder make institutional change more urgent: who is responsible, how money is spent and how people work.
          </p><a class="textlink small" href="https://en-cyber.tau.ac.il/our_team_rcrl"
            >Head, Cyber Resilience Laboratory<br />Tel Aviv University ↗</a
          >
        </div>
      </div>
    </section>
  </main><footer id="contact" class="wrap">
    <span>Dr. Lior Tabansky</span><a href="mailto:liortabansky@gmail.com">liortabansky@gmail.com ↗</a>
  </footer>
</div>
<script>
  const masthead = document.querySelector('.profile-masthead');
  const updateMasthead = () => masthead?.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', updateMasthead, { passive: true });
  updateMasthead();
</script>
