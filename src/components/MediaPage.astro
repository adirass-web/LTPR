---
import SiteShell from '~/components/SiteShell.astro';
import ResponsiveMediaImage from '~/components/media/ResponsiveMediaImage.astro';
import MediaVideoCard from '~/components/media/MediaVideoCard.astro';
import MediaPressCard from '~/components/media/MediaPressCard.astro';
import MoreCoverageItem from '~/components/media/MoreCoverageItem.astro';
import { archive, lead, press, videos } from '~/data/media';
import '~/assets/styles/media.css';

const asset = (file: string) => `${import.meta.env.BASE_URL}images/media/${file}`;
---

<SiteShell locale="en" page="media">
  <article class="media-page">
    <header class="media-page__intro">
      <p class="eyebrow">Selected appearances</p>
      <h1>Media</h1>
    </header>

    <section class="media-section" aria-labelledby="media-lead-title">
      <div class="media-lead">
        <div class="media-lead__visual-stack">
          <div class="media-lead__visual">
            <ResponsiveMediaImage
              image={lead.image}
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 46rem) 66vw, 100vw"
            />
          </div>
          <div class="media-lead__network" aria-hidden="true">
            <ResponsiveMediaImage image={lead.secondaryImage} sizes="(min-width: 46rem) 66vw, 100vw" />
          </div>
        </div>
        <div class="media-lead__copy">
          <p class="eyebrow">{lead.outlet}</p>
          <h2 id="media-lead-title">{lead.title}</h2>
          <p>{lead.date} · {lead.meta}</p>
          <p class="media-lead__source">Owner archive · RAI broadcast</p>
        </div>
      </div>
    </section>

    <section class="media-section" aria-labelledby="on-screen-title">
      <h2 id="on-screen-title">On screen</h2>
      <div class="media-grid">
        {videos.map((item) => <MediaVideoCard item={item} />)}
      </div>
    </section>

    <section class="media-section" aria-labelledby="press-title">
      <h2 id="press-title">Press &amp; features</h2>
      <div class="media-grid">
        {press.map((item) => <MediaPressCard item={item} />)}
      </div>
    </section>

    <section class="media-section" aria-labelledby="coverage-title">
      <h2 id="coverage-title">More coverage</h2>
      <div class="media-coverage-grid">
        {archive.map((item) => <MoreCoverageItem item={item} />)}
      </div>
    </section>

    <section class="media-section" aria-labelledby="stages-title">
      <h2 id="stages-title">Stages</h2>
      <div class="media-stages">
        <div class="media-visual--stage">
          <img
            src={asset('cycon-portrait.jpg')}
            width="720"
            height="960"
            loading="lazy"
            decoding="async"
            alt="Lior Tabansky speaking at CyCon"
          />
        </div>
        <dl class="media-stage-list">
          <div><dt>Tallinn</dt><dd>NATO CCDCOE · CyCon</dd></div>
          <div><dt>Copenhagen</dt><dd>Danish Parliament</dd></div>
          <div><dt>Rome</dt><dd>Camera dei Deputati</dd></div>
          <div><dt>Amsterdam</dt><dd>Future of War</dd></div>
          <div><dt>Singapore</dt><dd>APPSNO</dd></div>
          <div><dt>Tel Aviv</dt><dd>Cyber Week</dd></div>
        </dl>
      </div>
    </section>

    <section class="media-section media-press-kit" aria-labelledby="kit-title">
      <div class="media-book">
        <picture>
          <source
            type="image/avif"
            srcset={`${asset('book-110w.avif')} 110w, ${asset('book-220w.avif')} 220w`}
            sizes="110px"
          />
          <source
            type="image/webp"
            srcset={`${asset('book-110w.webp')} 110w, ${asset('book-220w.webp')} 220w`}
            sizes="110px"
          />
          <img
            src={asset('book.jpg')}
            width="220"
            height="330"
            loading="lazy"
            decoding="async"
            alt="Cybersecurity in Israel book cover"
          />
        </picture>
      </div>
      <div><h2 id="kit-title">Press kit</h2><p>Bio, headshots, book cover, contact.</p></div>
      <a class="cta cta--outline" href="mailto:liortabansky@gmail.com">Email</a>
    </section>
  </article>
</SiteShell>
