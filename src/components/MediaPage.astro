---
import SiteShell from '~/components/SiteShell.astro';

const asset = (file: string) => `${import.meta.env.BASE_URL}images/media/${file}`;
---

<SiteShell locale="en" page="media">
  <article class="media-page">
    <header class="media-page__intro">
      <p class="eyebrow">Selected appearances</p>
      <h1>Media</h1>
    </header>

    <section class="media-section media-section--lead" aria-labelledby="rai-title">
      <div class="media-lead">
        <a
          class="media-visual media-visual--lead"
          href="https://www.raiplay.it/video/2017/08/Cybersicurezza-esperti-a-confronto---18082017-753fa4f2-2a8e-4437-827f-7e2053734062.html"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Watch Cybersicurezza, esperti a confronto on RaiPlay, opens in a new tab"
        >
          <picture>
            <source media="(max-width: 45rem)" type="image/avif" srcset={`${asset('rai-lead-mobile-480w.avif')} 480w, ${asset('rai-lead-mobile-768w.avif')} 768w`} sizes="calc(100vw - 2rem)" />
            <source media="(max-width: 45rem)" type="image/webp" srcset={`${asset('rai-lead-mobile-480w.webp')} 480w, ${asset('rai-lead-mobile-768w.webp')} 768w`} sizes="calc(100vw - 2rem)" />
            <source type="image/avif" srcset={`${asset('rai-lead-wide-480w.avif')} 480w, ${asset('rai-lead-wide-768w.avif')} 768w, ${asset('rai-lead-wide-1024w.avif')} 1024w, ${asset('rai-lead-wide-1280w.avif')} 1280w`} sizes="(max-width: 52.5rem) 58vw, 66vw" />
            <source type="image/webp" srcset={`${asset('rai-lead-wide-480w.webp')} 480w, ${asset('rai-lead-wide-768w.webp')} 768w, ${asset('rai-lead-wide-1024w.webp')} 1024w, ${asset('rai-lead-wide-1280w.webp')} 1280w`} sizes="(max-width: 52.5rem) 58vw, 66vw" />
            <img src={asset('rai-lead-wide.jpg')} width="1280" height="720" fetchpriority="high" alt="" />
          </picture>
          <span class="media-play" aria-hidden="true">▶</span>
        </a>
        <div class="media-lead__copy">
          <p class="eyebrow">RAI · Codice: La vita è digitale</p>
          <h2 id="rai-title">Cybersicurezza, esperti a confronto</h2>
          <p>2017 · 8 min · Italian</p>
          <a class="text-link" href="https://www.raiplay.it/video/2017/08/Cybersicurezza-esperti-a-confronto---18082017-753fa4f2-2a8e-4437-827f-7e2053734062.html" target="_blank" rel="noopener noreferrer">RaiPlay <span aria-hidden="true">↗</span><span class="sr-only">, opens in a new tab</span></a>
        </div>
      </div>
    </section>

    <section class="media-section" aria-labelledby="press-title">
      <h2 id="press-title">Press</h2>
      <div class="media-press-list">
        <a class="media-press-row" href="https://www.lefigaro.fr/international/guerre-hamas-israel-tsahal-fait-entrer-l-intelligence-artificielle-dans-la-bataille-20231204" target="_blank" rel="noopener noreferrer" aria-label="Read Le Figaro: Guerre Hamas-Israël: Tsahal fait entrer l’intelligence artificielle dans la bataille, opens in a new tab">
          <span class="media-thumb"><picture><source type="image/avif" srcset={`${asset('figaro-160w.avif')} 160w, ${asset('figaro-320w.avif')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><source type="image/webp" srcset={`${asset('figaro-160w.webp')} 160w, ${asset('figaro-320w.webp')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><img src={asset('figaro.jpg')} width="320" height="240" loading="lazy" decoding="async" alt="" /></picture></span>
          <span class="media-press-row__copy"><span class="eyebrow">Le Figaro</span><span class="media-press-row__title" lang="fr">Guerre Hamas-Israël: Tsahal fait entrer l’intelligence artificielle dans la bataille</span><span class="media-meta">4 December 2023</span></span><span class="media-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="media-press-row" href="https://apnews.com/article/technology-middle-east-iran-dubai-b0404963ae23e5008439a0b607952de1" target="_blank" rel="noopener noreferrer" aria-label="Read Associated Press: Cyberattack forces Iran steel company to halt production, opens in a new tab">
          <span class="media-thumb media-thumb--logo"><picture><source type="image/avif" srcset={`${asset('ap-160w.avif')} 160w, ${asset('ap-320w.avif')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><source type="image/webp" srcset={`${asset('ap-160w.webp')} 160w, ${asset('ap-320w.webp')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><img src={asset('ap.jpg')} width="320" height="320" loading="lazy" decoding="async" alt="" /></picture></span>
          <span class="media-press-row__copy"><span class="eyebrow">Associated Press</span><span class="media-press-row__title">Cyberattack forces Iran steel company to halt production</span><span class="media-meta">27 June 2022</span></span><span class="media-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="media-press-row" href="https://www.nrc.nl/nieuws/2022/01/04/surveillance-industrie-israel-in-schijnwerpers-door-pegasus-schandaal-a4075654" target="_blank" rel="noopener noreferrer" aria-label="Read NRC: Surveillance-industrie Israël in schijnwerpers door Pegasus-schandaal, opens in a new tab">
          <span class="media-thumb media-thumb--logo"><picture><source type="image/avif" srcset={`${asset('nrc-160w.avif')} 160w, ${asset('nrc-320w.avif')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><source type="image/webp" srcset={`${asset('nrc-160w.webp')} 160w, ${asset('nrc-320w.webp')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><img src={asset('nrc.png')} width="320" height="135" loading="lazy" decoding="async" alt="" /></picture></span>
          <span class="media-press-row__copy"><span class="eyebrow">NRC</span><span class="media-press-row__title" lang="nl">Surveillance-industrie Israël in schijnwerpers door Pegasus-schandaal</span><span class="media-meta">4 January 2022</span></span><span class="media-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="media-press-row" href="https://www.repubblica.it/tecnologia/sicurezza/2020/05/20/news/israele_vs_iran_il_nuovo_fronte_di_guerra_e_il_cyberspazio-257140929/" target="_blank" rel="noopener noreferrer" aria-label="Read la Repubblica: Israele vs Iran: il nuovo fronte di guerra è il cyberspazio, opens in a new tab">
          <span class="media-thumb media-thumb--logo"><picture><source type="image/avif" srcset={`${asset('repubblica-160w.avif')} 160w, ${asset('repubblica-320w.avif')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><source type="image/webp" srcset={`${asset('repubblica-160w.webp')} 160w, ${asset('repubblica-320w.webp')} 320w`} sizes="(max-width: 45rem) 86px, 150px" /><img src={asset('repubblica.png')} width="320" height="71" loading="lazy" decoding="async" alt="" /></picture></span>
          <span class="media-press-row__copy"><span class="eyebrow">la Repubblica</span><span class="media-press-row__title" lang="it">Israele vs Iran: il nuovo fronte di guerra è il cyberspazio</span><span class="media-meta">20 May 2020</span></span><span class="media-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="media-section" aria-labelledby="video-title">
      <h2 id="video-title">Video</h2>
      <div class="media-video-grid">
        <article><a class="media-visual media-visual--video" href="https://www.youtube.com/watch?v=gcMpVGqQV-w" target="_blank" rel="noopener noreferrer" aria-label="Watch ליאור טבנסקי: למי אכפת ש״חמאס תקף אתרים ישראלים״ on YouTube, opens in a new tab"><picture><source type="image/avif" srcset={`${asset('video-latest-480w.avif')} 480w, ${asset('video-latest-768w.avif')} 768w`} sizes="(max-width: 45rem) calc(100vw - 2rem), 50vw" /><source type="image/webp" srcset={`${asset('video-latest-480w.webp')} 480w, ${asset('video-latest-768w.webp')} 768w`} sizes="(max-width: 45rem) calc(100vw - 2rem), 50vw" /><img src={asset('video-latest.jpg')} width="768" height="480" loading="lazy" decoding="async" alt="" /></picture><span class="media-play" aria-hidden="true">▶</span></a><p class="eyebrow">L Tabansky</p><h3 dir="rtl" lang="he">ליאור טבנסקי: למי אכפת ש״חמאס תקף אתרים ישראלים״?</h3><p class="media-meta">4 July 2026 · 5:43 · Hebrew</p></article>
        <article><a class="media-visual media-visual--video" href="https://www.youtube.com/watch?v=ia8hKfw6e9Q" target="_blank" rel="noopener noreferrer" aria-label="Watch פוליטיקה עם עודד שחר on YouTube, opens in a new tab"><picture><source type="image/avif" srcset={`${asset('video-2012-480w.avif')} 480w, ${asset('video-2012-768w.avif')} 768w`} sizes="(max-width: 45rem) calc(100vw - 2rem), 50vw" /><source type="image/webp" srcset={`${asset('video-2012-480w.webp')} 480w, ${asset('video-2012-768w.webp')} 768w`} sizes="(max-width: 45rem) calc(100vw - 2rem), 50vw" /><img src={asset('video-2012.jpg')} width="768" height="480" loading="lazy" decoding="async" alt="" /></picture><span class="media-play" aria-hidden="true">▶</span></a><p class="eyebrow">Israel Channel 1</p><h3 dir="rtl" lang="he">פוליטיקה עם עודד שחר</h3><p class="media-meta">3 January 2012 · 22:00 · Hebrew</p></article>
      </div>
      <a class="text-link media-channel-link" href="https://www.youtube.com/@ltabansky6248/videos" target="_blank" rel="noopener noreferrer">All videos <span aria-hidden="true">↗</span><span class="sr-only">, opens in a new tab</span></a>
    </section>

    <section class="media-section" aria-labelledby="stages-title">
      <h2 id="stages-title">Stages</h2>
      <div class="media-stages"><div class="media-visual media-visual--stage"><picture><source media="(max-width: 45rem)" type="image/avif" srcset={`${asset('cycon-mobile-480w.avif')} 480w, ${asset('cycon-mobile-720w.avif')} 720w`} sizes="calc(100vw - 2rem)" /><source media="(max-width: 45rem)" type="image/webp" srcset={`${asset('cycon-mobile-480w.webp')} 480w, ${asset('cycon-mobile-720w.webp')} 720w`} sizes="calc(100vw - 2rem)" /><source type="image/avif" srcset={`${asset('cycon-portrait-480w.avif')} 480w, ${asset('cycon-portrait-720w.avif')} 720w`} sizes="(max-width: 52.5rem) 36vw, 30vw" /><source type="image/webp" srcset={`${asset('cycon-portrait-480w.webp')} 480w, ${asset('cycon-portrait-720w.webp')} 720w`} sizes="(max-width: 52.5rem) 36vw, 30vw" /><img src={asset('cycon-portrait.jpg')} width="720" height="960" loading="lazy" decoding="async" alt="Lior Tabansky speaking at CyCon" /></picture></div><dl class="media-stage-list"><div><dt>Tallinn</dt><dd>NATO CCDCOE · CyCon</dd></div><div><dt>Copenhagen</dt><dd>Danish Parliament</dd></div><div><dt>Rome</dt><dd>Camera dei Deputati</dd></div><div><dt>Amsterdam</dt><dd>Future of War</dd></div><div><dt>Singapore</dt><dd>APPSNO</dd></div><div><dt>Tel Aviv</dt><dd>Cyber Week</dd></div></dl></div>
    </section>

    <section class="media-section media-press-kit" aria-labelledby="kit-title">
      <div class="media-book"><picture><source type="image/avif" srcset={`${asset('book-110w.avif')} 110w, ${asset('book-220w.avif')} 220w`} sizes="72px" /><source type="image/webp" srcset={`${asset('book-110w.webp')} 110w, ${asset('book-220w.webp')} 220w`} sizes="72px" /><img src={asset('book.jpg')} width="220" height="330" loading="lazy" decoding="async" alt="Cybersecurity in Israel book cover" /></picture></div>
      <div><h2 id="kit-title">Press kit</h2><p>Bio, headshots, book cover, contact.</p></div>
      <a class="cta cta--outline" href="mailto:liortabansky@gmail.com">Email</a>
    </section>
  </article>
</SiteShell>
